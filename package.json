{
  "name": "consensus-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "npm run build:web && concurrently -k \"vite build --watch\" \"tsx watch src/server/index.ts\"",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "build:web": "vite build",
    "build": "npm run typecheck && npm run build:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run test && npm run build",
    "verify:static": "tsx src/server/verificationCli.ts",
    "explore": "tsx src/server/exploreCli.ts"
    ,"compare:search": "node scripts/search-comparison.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.6.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "jsdom": "^27.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
